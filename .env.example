# Copier en .env et remplacer chaque valeur. Ne jamais versionner .env.
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hébergement (Vercel, Neon, Supabase…) : une seule URL remplace les variables POSTGRES_* ci-dessous.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require

POSTGRES_DB=lanfiasave
POSTGRES_USER=lanfiasave
POSTGRES_PASSWORD=remplacer
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# Mot de passe commun des comptes de démonstration créés par `manage.py seed_demo` (données synthétiques).
DEMO_PASSWORD=remplacer
